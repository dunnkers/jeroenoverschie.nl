<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{!-- Dark mode follows the system setting. Declaring both schemes up front
    lets the browser paint the right canvas color before the stylesheet loads,
    and theme-color matches the browser's own UI to the page background. --}}
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#fff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#000" media="(prefers-color-scheme: dark)">
    <title>{{meta_title page=(t " (Page %)")}}</title>

    <link rel="stylesheet" href="{{asset "built/screen.css"}}">

    {{!-- No image preloads: the LCP candidates (cover image/icon, post feature
    image) are plain <img fetchpriority="high"> tags the preload scanner finds
    on its own. A preload of the feature image also couldn't match the size the
    <img> picks from its srcset, so it was downloaded twice. --}}

    {{!-- This site is published as a static export, where Ghost's search
    (sodo-search) can't reach the Content API at runtime. So there are no search
    buttons in the header, and Ghost's search script isn't loaded either. --}}
    {{ghost_head exclude="search"}}

    {{!-- ghost_head sets the referrer policy to no-referrer-when-downgrade,
    which sends the full page URL to every site a visitor follows a link to.
    Restore the browser default, so other sites only see the origin
    (jeroenoverschie.nl); same-site links keep the full URL. A meta tag because
    GitHub Pages can't set a Referrer-Policy header; it must come after
    ghost_head, as the browser applies the last referrer meta tag it sees. --}}
    <meta name="referrer" content="strict-origin-when-cross-origin">
</head>

<body class="{{body_class}}{{{block "body_class"}}} is-head-{{#match @custom.navigation_layout "Logo on the left"}}left-logo{{else match @custom.navigation_layout "Logo in the middle"}}middle-logo{{else}}stacked{{/match}}{{#match @custom.title_font "=" "Elegant serif"}} has-serif-title{{/match}}{{#match @custom.body_font "=" "Elegant serif"}} has-serif-body{{/match}}{{^is "home"}}{{#if @site.cover_image}} is-head-brand{{/if}}{{/is}}">
<div class="site">

    <header id="gh-head" class="gh-head gh-outer">
        <div class="gh-head-inner">
            <div class="gh-head-brand">
                <div class="gh-head-brand-wrapper">
                    <a class="gh-head-logo" href="{{@site.url}}">
                        {{#if @site.logo}}
                            <img src="{{@site.logo}}" alt="{{@site.title}}">
                        {{else}}
                            {{@site.title}}
                        {{/if}}
                    </a>
                </div>
                <button class="gh-burger" aria-label="{{t "Toggle menu"}}"></button>
            </div>

            <nav class="gh-head-menu" aria-label="{{t "Primary"}}">
                {{navigation}}
            </nav>

            <div class="gh-head-actions">
                {{#if @site.members_enabled}}
                    <div class="gh-head-members">
                        {{#unless @member}}
                            {{#unless @site.members_invite_only}}
                                <a class="gh-head-link" href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
                                <a class="gh-head-btn gh-btn gh-primary-btn" href="#/portal/signup" data-portal="signup">{{t "Subscribe"}}</a>
                            {{else}}
                                <a class="gh-head-btn gh-btn gh-primary-btn" href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
                            {{/unless}}
                        {{else}}
                            <a class="gh-head-btn gh-btn gh-primary-btn" href="#/portal/account" data-portal="account">{{t "Account"}}</a>
                        {{/unless}}
                    </div>
                {{/if}}
            </div>
        </div>
    </header>

    {{#is "home"}}
        {{> "cover"}}
        {{#if @custom.show_featured_posts}}
            {{> "featured-posts"}}
        {{/if}}
    {{/is}}

    <div class="site-content">
        {{{body}}}
    </div>

    {{!-- Three columns: copyright | centre | spare. The centre column has
         two sources, edited in two places in Ghost admin:
         - "Elsewhere" icons: LinkedIn etc. from Settings > Social accounts, then
           the services Ghost has no field for, from Design > Site-wide (theme
           settings). Each link is named by visually hidden text.
         - Below them: Settings > Navigation > Secondary.
         The empty .gh-foot-col-extra keeps the right-hand column free. --}}
    <footer class="gh-foot gh-outer">
        <div class="gh-foot-inner gh-inner">
            <p class="gh-copyright">{{@site.title}} © {{date format="YYYY"}}</p>
            <div class="gh-foot-center">
                <nav class="gh-foot-social" aria-label="{{t "Elsewhere"}}">
                    <ul class="gh-social-links">
                        {{#social_accounts @site}}
                            {{> "foot-link" href=href name=name icon=type}}
                        {{/social_accounts}}
                        {{> "foot-link" href=@custom.goodreads_url name="Goodreads" icon="goodreads"}}
                        {{> "foot-link" href=@custom.github_url name="GitHub" icon="github"}}
                        {{> "foot-link" href=@custom.youtube_url name="YouTube" icon="youtube"}}
                        {{> "foot-link" href=@custom.unsplash_url name="Unsplash" icon="unsplash"}}
                        {{> "foot-link" href=@custom.google_scholar_url name="Google Scholar" icon="google-scholar"}}
                        {{!-- The site's own feed, so no theme setting: it always exists. --}}
                        {{> "foot-link" href=(concat @site.url "/rss/") name="RSS feed" icon="rss" rel="alternate noopener" type="application/rss+xml"}}
                    </ul>
                </nav>
                {{#if @site.secondary_navigation}}
                    <nav class="gh-foot-menu" aria-label="{{t "Secondary"}}">
                        {{navigation type="secondary"}}
                    </nav>
                {{/if}}
            </div>
            <div class="gh-foot-col-extra"></div>
        </div>
    </footer>

</div>

{{#is "post, page"}}
    {{> "pswp"}}
{{/is}}

<script src="{{asset "built/main.min.js"}}" defer></script>

{{ghost_foot}}

</body>
</html>